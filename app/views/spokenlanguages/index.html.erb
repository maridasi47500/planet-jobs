<p style="color: green"><%= notice %></p>

<% content_for :title, "Spokenlanguages" %>

<h1>Spokenlanguages</h1>

<div id="spokenlanguages">
  <% @spokenlanguages.each do |spokenlanguage| %>
    <%= render spokenlanguage %>
    <p>
      <%= link_to "Show this spokenlanguage", spokenlanguage %>
    </p>
  <% end %>
</div>

<%= link_to "New spokenlanguage", new_spokenlanguage_path %>
