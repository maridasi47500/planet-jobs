<%= form_with(model: resume) do |form| %>
  <% if resume.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(resume.errors.count, "error") %> prohibited this resume from being saved:</h2>

      <ul>
        <% resume.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.number_field :user_id %>
  </div>

  <div>
    <%= form.label :poste_convoite, style: "display: block" %>
    <%= form.text_field :poste_convoite %>
  </div>

  <div>
    <%= form.label :nom_complet, style: "display: block" %>
    <%= form.text_field :nom_complet %>
  </div>

  <div>
    <%= form.label :ville, style: "display: block" %>
    <%= form.text_field :ville %>
  </div>

  <div>
    <%= form.label :permis, style: "display: block" %>
    <%= form.text_field :permis %>
  </div>

  <div>
    <%= form.label :projet_professionnel, style: "display: block" %>
    <%= form.text_field :projet_professionnel %>
  </div>

  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email %>
  </div>

  <div>
    <%= form.label :phone, style: "display: block" %>
    <%= form.text_field :phone %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
