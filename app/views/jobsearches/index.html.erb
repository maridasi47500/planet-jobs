<p style="color: green"><%= notice %></p>

<% content_for :title, "Jobsearches" %>

<h1>Jobsearches</h1>

<div id="jobsearches">
  <% @jobsearches.each do |jobsearch| %>
    <%= render jobsearch %>
    <p>
      <%= link_to "Show this jobsearch", jobsearch %>
    </p>
  <% end %>
</div>

<%= link_to "New jobsearch", new_jobsearch_path %>
