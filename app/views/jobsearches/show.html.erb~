<p style="color: green"><%= notice %></p>

<%= render @jobsearch %>

<p>
  tu as été régulière sur la recherche de <%=@jobsearch.what%> à <%=@jobsearch.where%> que 1 jours sur 7 .
</p>
<div class="progress">
  <%x=1%>
  <%x+=Usersearch.where(created_at: ((Date.today - 6.days).beginning_of_day..Date.yesterday.end_of_day)).length%>
  <div class="progress-bar" style="width:<%=x/7.to_f*100.to_i%>%"></div>
</div>




<p>
<a href="https://fr.indeed.com/jobs?q=<%=@jobsearch.what.gsub(" ","+")%>&l=<%=@jobsearch.where.gsub(" ","+")%>&radius=25&from=searchOnDesktopSerp&vjk=913060760e6849bc" target="_blank">rechercher sur indeed</a>
</p>







<div>
  <%= link_to "Edit this jobsearch", edit_jobsearch_path(@jobsearch) %> |
  <%= link_to "Back to jobsearches", jobsearches_path %>

  <%= button_to "Destroy this jobsearch", @jobsearch, method: :delete %>
</div>
