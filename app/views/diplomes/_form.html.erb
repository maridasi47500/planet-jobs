  </div>

  <div>
    <%= form.label :nom_ecole, style: "display: block" %>
    <%= form.text_field :nom_ecole %>
  </div>

  <div>
    <%= form.label :lieu, style: "display: block" %>
    <%= form.text_field :lieu %>
  </div>

  <div>
    <%= form.label :details, style: "display: block" %>
    <%= form.textarea :details %>
  </div>

  <div>
