<div id="<%= dom_id challenge %>">
  <div>
    <strong>Title:</strong>
    <%= challenge.title %>
  </div>

  <div>
    <strong>Content:</strong>
    <%= challenge.content %>
  </div>

  <div>
    <strong>User:</strong>
    <%= challenge.user_id %>
  </div>

  <div>
    <strong>Length of time:</strong>
    <%begin%>
    <%= distance_of_time_in_words_to_now(eval("Time.now - ("+challenge.length_of_time+")"))%>
    <%= challenge.length_of_time%>
  <%rescue => e%>
    <%="error"+e.message%>
  <%end%>
  </div>

  <div>
    <strong>Pic:</strong>
    <%= challenge.pic %>
  </div>

</div>
