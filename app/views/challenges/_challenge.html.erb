<div id="<%= dom_id challenge %>">
  <div>
    <strong>Title:</strong>
    <%= challenge.title %>
  </div>

  <div>
    <strong>Content:</strong>
    <%= challenge.content %>
  </div>

  <div>
    <strong>User:</strong>
    <%= challenge.user_id %>
  </div>

  <div>
    <strong>Length of time:</strong>
    <%= challenge.length_of_time %>
  </div>

  <div>
    <strong>Pic:</strong>
    <%= challenge.pic %>
  </div>

</div>
